--- !u!114 &1200356236
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1200356235}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab6c2ac948f1a1546ac269512a87842c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SecretRoomController
  playerController: {fileID: 1644085112}
  playerTransform: {fileID: 1644085115}
  yesLines:
  - speaker: Player
    text: Yes. I trust you.
  - speaker: Stranger
    text: Even after everything you've seen?
  - speaker: Player
    text: You helped me survive this place.
  - speaker: Stranger
    text: No...
  - speaker: Stranger
    text: You helped me survive.
  - speaker: Stranger
    text: And now... I no longer need to pretend.
  noLines:
  - speaker: Player
    text: No. I don't trust you.
  - speaker: Stranger
    text: I was wondering when you would understand.
  - speaker: Player
    text: The forbidden room... the recorder... the photographs. They were all connected
      to you.
  - speaker: Stranger
    text: Yes. This was my house.
  - speaker: Stranger
    text: The people in those photographs trusted me too.
  - speaker: Stranger
    text: I didn't need your help to escape.
  - speaker: Stranger
    text: I needed someone to open the secret room.
  - speaker: Stranger
    text: And you were the key.
  strangerTransform: {fileID: 1156050417}
  strangerRenderer: {fileID: 1156050416}
  monsterColor: {r: 1, g: 1, b: 1, a: 1}
