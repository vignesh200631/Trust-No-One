--- !u!114 &1644085119
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1644085111}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2e94bb9a17fa0f4cb5578b36137713d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroDialogue
  introLines:
  - speaker: Player
    text: This passage was hidden behind the locker...
  - speaker: Stranger
    text: I told you we were getting closer.
  - speaker: Player
    text: Closer to what?
  - speaker: Stranger
    text: The way out.
  - speaker: Player
    text: You seem to know this place.
  - speaker: Stranger
    text: I've been trapped here for a long time.
  - speaker: Player
    text: Then why didn't you tell me about this passage?
  - speaker: Stranger
    text: Some doors only open when the right person finds them.
  - speaker: Stranger
    text: And you found it.
  - speaker: Stranger
    text: You've helped me come this far.
  - speaker: Stranger
    text: But before we go any further...
  - speaker: Stranger
    text: There's something I need to ask you.
  - speaker: Stranger
    text: Do you trust me?
  playerController: {fileID: 1644085112}
  trustChoiceManager: {fileID: 594430566}
