--- !u!114 &1644085119
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1644085111}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b2e94bb9a17fa0f4cb5578b36137713d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroDialogue
  introLines:
  - speaker: Player
    text: Is this... the way out?
  - speaker: Stranger
    text: Yes.
  - speaker: Player
    text: That door?
  - speaker: Stranger
    text: It leads outside.
  - speaker: Player
    text: Finally...
  - speaker: Stranger
    text: We made it.
  - speaker: Player
    text: After everything in this house... I can't believe we're actually getting
      out.
  - speaker: Stranger
    text: You did well.
  - speaker: Player
    text: We did.
  - speaker: Stranger
    text: ...
  - speaker: Player
    text: What?
  - speaker: Stranger
    text: Nothing.
  - speaker: Stranger
    text: Before we leave, I want to ask you something.
  - speaker: Player
    text: What is it?
  - speaker: Stranger
    text: You've followed me through this entire house.
  - speaker: Stranger
    text: You listened to what I said.
  - speaker: Stranger
    text: You trusted my instructions.
  - speaker: Player
    text: You helped me get this far.
  - speaker: Stranger
    text: Did I?
  - speaker: Player
    text: What do you mean?
  - speaker: Stranger
    text: Nothing.
  - speaker: Stranger
    text: Just answer one question.
  playerController: {fileID: 1644085112}
  trustChoiceManager: {fileID: 594430566}
