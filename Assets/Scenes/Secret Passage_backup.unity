--- !u!114 &1200356236
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1200356235}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab6c2ac948f1a1546ac269512a87842c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SecretRoomController
  playerController: {fileID: 1644085112}
  playerTransform: {fileID: 1644085115}
  yesLines:
  - speaker: Player
    text: Yes. I trust you.
  - speaker: Stranger
    text: Good.
  - speaker: Player
    text: Why are you asking?
  - speaker: Stranger
    text: Because trust is such a powerful thing.
  - speaker: Player
    text: What do you mean?
  - speaker: Stranger
    text: It makes people follow.
  - speaker: Stranger
    text: Even when they should run.
  - speaker: Player
    text: ...
  - speaker: Stranger
    text: And you...
  - speaker: Stranger
    text: You trusted me.
  noLines:
  - speaker: Player
    text: No.
  - speaker: Stranger
    text: ...
  - speaker: Player
    text: I don't trust you.
  - speaker: Stranger
    text: After everything we've been through?
  - speaker: Player
    text: You've known too much from the beginning.
  - speaker: Player
    text: You told me where to go.
  - speaker: Player
    text: What to find.
  - speaker: Player
    text: What to avoid.
  - speaker: Stranger
    text: ...
  - speaker: Player
    text: Who are you?
  - speaker: Stranger
    text: I was wondering when you would ask.
  - speaker: Stranger
    text: You were supposed to trust me.
  - speaker: Player
    text: Why?
  - speaker: Stranger
    text: Because that's how everyone gets out.
  - speaker: Player
    text: What?
  - speaker: Stranger
    text: They follow me.
  - speaker: Stranger
    text: They trust me.
  - speaker: Stranger
    text: And then...
  - speaker: Stranger
    text: They never leave.
  strangerTransform: {fileID: 1156050417}
  strangerRenderer: {fileID: 1156050416}
  monsterColor: {r: 0.8831452, g: 1, b: 0, a: 1}
  yesMoveSpeed: 1
  stopDistance: 1.2
  monsterChase: {fileID: 1156050419}
  fadeCanvasGroup: {fileID: 696326647}
  fadeDuration: 3
