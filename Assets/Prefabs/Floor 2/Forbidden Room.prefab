  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TapeRecorder
  interactionPrompt: Play
  recordingLines:
  - speaker: Player
    text: An old tape recorder...
  - speaker: Player
    text: Let's see what's on it.
  - speaker: RECORDING
    text: 'They always come here...

'
  - speaker: RECORDING
    text: They always want to leave...
  - speaker: RECORDING
    text: They always need someone to trust...
  - speaker: RECORDING
    text: And eventually...
  - speaker: RECORDING
    text: They help me.
