--- !u!114 &113099960564534802
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 236401542988397487}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 490cdba6a0ca35347b24e92eb58a740c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Floor2StrangerInteraction
  interactionPrompt: Talk
  tapeRecorder: {fileID: 0}
  locker: {fileID: 0}
  secretRoomKey: {fileID: 0}
  beforeInvestigationLines:
  - speaker: Player
    text: Have you found anything?
  - speaker: Stranger
    text: Nothing useful.
  - speaker: Stranger
    text: Keep looking around.
  afterInvestigationLines:
  - speaker: Player
    text: There's something strange in that room.
  - speaker: Stranger
    text: What did you find?
  - speaker: Player
    text: An old tape recorder.
  - speaker: Player
    text: And a locked locker.
  - speaker: Stranger
    text: A locker?
  - speaker: Player
    text: Yeah.
  - speaker: Player
    text: It needs a four-digit code.
  - speaker: Stranger
    text: Hmm...
  - speaker: Player
    text: And the tape...
  - speaker: Player
    text: The voice on it said something strange.
  - speaker: Stranger
    text: What did it say?
  - speaker: Player
    text: It said...
  - speaker: Player
    text: '"They always need someone to trust."'
  - speaker: Player
    text: '"And eventually... they help me."'
  - speaker: Stranger
    text: ...
  - speaker: Player
    text: You know something about this place, don't you?
  - speaker: Stranger
    text: No.
  - speaker: Player
    text: Then why are you acting strange?
  - speaker: Stranger
    text: I'm not.
  - speaker: Player
    text: Forget it.
  - speaker: Stranger
    text: Wait.
  - speaker: Player
    text: What?
  - speaker: Stranger
    text: The photographs.
  - speaker: Player
    text: What about them?
  - speaker: Stranger
    text: There are photographs around this floor.
  - speaker: Stranger
    text: Four of them, I think.
  - speaker: Player
    text: And?
  - speaker: Stranger
    text: Maybe the locker code is hidden in them.
  - speaker: Player
    text: How?
  - speaker: Stranger
    text: Look at them carefully.
  - speaker: Stranger
    text: Arrange them in the correct order.
  - speaker: Stranger
    text: The numbers might reveal the code.
  - speaker: Player
    text: You seem pretty sure.
  - speaker: Stranger
    text: It's just an idea.
  - speaker: Player
    text: Fine.
  - speaker: Player
    text: I'll check the photographs.
  keyFoundLines:
  - speaker: Player
    text: I found something inside the locker.
  - speaker: Stranger
    text: What is it?
  - speaker: Player
    text: A key.
  - speaker: Stranger
    text: A key...
  - speaker: Player
    text: You know where it goes?
  - speaker: Stranger
    text: Maybe.
  - speaker: Player
    text: Maybe?
  - speaker: Stranger
    text: There was a locked door near the end of this floor.
  - speaker: Player
    text: The one we couldn't open?
  - speaker: Stranger
    text: Yes.
  - speaker: Player
    text: And you think this key opens it?
  - speaker: Stranger
    text: There's only one way to find out.
  - speaker: Player
    text: You seem to know this house better than you should.
  - speaker: Stranger
    text: ...
  - speaker: Stranger
    text: Let's just get out of here.
  repeatLines:
  - speaker: Stranger
    text: Find the four photographs.
  - speaker: Stranger
    text: Arrange them in the correct order.
  - speaker: Stranger
    text: The answer should be there.
  afterKeyRepeatLines:
  - speaker: Stranger
    text: Try the key on that locked door.
  - speaker: Stranger
    text: It could be our way out.
