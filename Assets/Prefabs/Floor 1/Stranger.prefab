--- !u!114 &1154945353718395880
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3947305853258083165}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d261b709851cbd848b06ee2f37a3d29b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StrangerInteraction
  interactionPrompt: Talk
  firstMeetingLines:
  - speaker: Stranger
    text: Thank God...
  - speaker: Stranger
    text: You're real.
  - speaker: Player
    text: Who are you?
  - speaker: Stranger
    text: I could ask you the same thing.
  - speaker: Player
    text: How did you get here?
  - speaker: Stranger
    text: I don't know.
  - speaker: Stranger
    text: I woke up here.
  - speaker: Stranger
    text: Just like you.
  - speaker: Player
    text: Have you found a way out?
  - speaker: Stranger
    text: Not yet.
  - speaker: Stranger
    text: But I think there is a way out.
  - speaker: Stranger
    text: Somewhere upstairs.
  - speaker: Player
    text: Then why haven't you gone?
  - speaker: Stranger
    text: The staircase is locked.
  - speaker: Stranger
    text: The power is out.
  - speaker: Stranger
    text: If we restore the electricity, it might unlock.
  - speaker: Player
    text: And you want my help.
  - speaker: Stranger
    text: Yes.
  - speaker: Stranger
    text: I can't do this alone.
  - speaker: Player
    text: Fine.
  - speaker: Player
    text: Let's get out of here.
  - speaker: Stranger
    text: Thank you.
  - speaker: Stranger
    text: I knew you would help me.
  repeatLines: []
