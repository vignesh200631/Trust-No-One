--- !u!114 &3586954870603376746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2485314633005541220}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 089c119f026b867499defc5dc1da1ccd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Fusepickup
  interactionPrompt: Pick up
  pickupLines:
  - speaker: Player
    text: That's the second one.
  - speaker: Player
    text: Did you hear that?
  - speaker: Stranger
    text: Yes.
  - speaker: Player
    text: What was it?
  - speaker: Stranger
    text: The house is old.
  - speaker: Stranger
    text: Things fall apart.
  - speaker: Player
    text: That didn't sound like the house.
  - speaker: Stranger
    text: There is no one else here.
  - speaker: Player
    text: How do you know?
  - speaker: Stranger
    text: Because I've been here long enough.
  - speaker: Player
    text: How long?
  - speaker: Stranger
    text: ...
  - speaker: Stranger
    text: Just find the last fuse.
