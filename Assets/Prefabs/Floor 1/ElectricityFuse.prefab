--- !u!114 &4281568099661577411
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8215735417597731039}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4fefcb3bd3fc7b54ea7fe5c99ffb505c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FuseBox
  interactionPrompt: Inspect
  boxExplainedLines:
  - speaker: Player
    text: The fuse box is empty.
  - speaker: Stranger
    text: It's missing three fuses.
  - speaker: Player
    text: Then we need to find them.
  - speaker: Stranger
    text: They should be somewhere on this floor.
  - speaker: Player
    text: You seem to know a lot about this place.
  - speaker: Stranger
    text: I've been looking around.
  - speaker: Stranger
    text: That's all.
  powerRestoredLines:
  - speaker: Stranger
    text: Finally...
  - speaker: Player
    text: Wait.
  - speaker: Stranger
    text: What?
  - speaker: Player
    text: I saw you.
  - speaker: Stranger
    text: I'm right here.
  - speaker: Player
    text: On that screen.
  - speaker: Stranger
    text: Probably an old recording.
  - speaker: Player
    text: It was you.
  - speaker: Stranger
    text: You don't know that.
  - speaker: Player
    text: You were wearing the same clothes.
  - speaker: Stranger
    text: ...
  - speaker: Stranger
    text: The staircase is unlocked.
  - speaker: Stranger
    text: We should go.
  lockedStaircaseBlocker: {fileID: 0}
